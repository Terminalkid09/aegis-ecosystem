{
	# Disable automatic HTTPS for the catch-all :80 listener below
	auto_https disable_redirects
}

# For dev: tls internal (auto self-signed)
# For production: tls your@email.com (Let's Encrypt ACME) with a real domain
aegis.local {
	tls internal

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@api path /api/*
	handle @api {
		reverse_proxy aegis-brain:8000
	}

	@ws path /ws/*
	handle @ws {
		reverse_proxy aegis-brain:8000
	}

	# Audit S5: la dashboard era servita SENZA Content-Security-Policy (i CSP
	# settati in aegis-brain/main.py coprono solo /api/*). Con azioni SOC a un
	# click una XSS nella UI e' la superficie che conta: qui si blinda il
	# frontend. `connect-src` include ws/wss per il feed live /api/v1/ws/*.
	handle {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		}
		reverse_proxy aegis-frontend:3000
	}
}

:80 {
	redir https://aegis.local{uri} permanent
}
