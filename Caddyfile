{
	# Disable automatic HTTPS for the catch-all :80 listener below
	auto_https disable_redirects
}

# AEGIS_DOMAIN is the public FQDN, set in .env. The lab default is
# aegis.local with Caddy's internal CA. For a real deployment set
# AEGIS_DOMAIN=soc.example.com and ACME_EMAIL=admin@example.com: Caddy then
# obtains and renews a Let's Encrypt certificate automatically (DNS must point
# here and ports 80/443 must be reachable for the ACME challenge).
{$AEGIS_DOMAIN:aegis.local} {
	tls {$ACME_EMAIL:internal}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@api path /api/*
	handle @api {
		reverse_proxy aegis-brain:8000
	}

	@ws path /ws/*
	handle @ws {
		reverse_proxy aegis-brain:8000
	}

	# Kraken is a separate service. `handle_path` strips /kraken before the
	# request reaches it, so its own API/static/template paths stay unchanged;
	# the UI uses a <base href="/kraken/"> for every relative link.
	redir /kraken /kraken/ 308
	handle_path /kraken/* {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		}
		reverse_proxy aegis-kraken:8000
	}

	# Audit S5: la dashboard era servita SENZA Content-Security-Policy (i CSP
	# settati in aegis-brain/main.py coprono solo /api/*). Con azioni SOC a un
	# click una XSS nella UI e' la superficie che conta: qui si blinda il
	# frontend. `connect-src` include ws/wss per il feed live /api/v1/ws/*.
	handle {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		}
		reverse_proxy aegis-frontend:3000
	}
}

:80 {
	redir https://{$AEGIS_DOMAIN:aegis.local}{uri} permanent
}
