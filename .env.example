# .env.example for Aegis XDR Ecosystem
# Copy to .env and replace every placeholder before use.

# ─── Docker Compose (recommended) ───────────────────────────────────────────
# When using `docker compose up`, service hostnames are container names.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=aegis
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-postgres-password@aegis-postgres:5432/aegis

REDIS_PASSWORD=replace-with-a-long-random-value
REDIS_URL=redis://:replace-with-a-long-random-value@aegis-redis:6379
REDIS_HOST=aegis-redis
REDIS_PORT=6379
REDIS_PORT_EXTERNAL=6379

# ─── Local development (services on localhost) ──────────────────────────────
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/aegis
# REDIS_URL=redis://:your_redis_password@localhost:6379
# REDIS_HOST=localhost

# ─── SERVICE PORTS ───────────────────────────────────────────────────────────
POSTGRES_PORT=5444
BRAIN_PORT_EXTERNAL=8000
LINK_PORT_EXTERNAL=8088
OLLAMA_PORT_EXTERNAL=11435

# ─── SECURITY (REQUIRED: generate with `python -c "import secrets; print(secrets.token_hex(32))"`) ─────
AEGIS_API_KEY=replace-with-random-hex-32-chars-min
AGENT_ENROLL_KEY=replace-with-random-value
JWT_SECRET=replace-with-at-least-32-random-characters
MASTER_KEY_B64=replace-with-openssl-rand-32-base64
JWT_ALGORITHM=HS256
# Durata della sessione (JWT + cookie). Con il rinnovo a scorrimento, una
# dashboard in uso non viene mai interrotta: il contatore riparte a ogni
# attivita' e scade davvero solo dopo questo tempo di inattivita'.
# Alzalo (es. 480) se l'operatore tiene la console aperta per un turno intero.
JWT_EXPIRE_MINUTES=60

# ─── OSINT API KEYS (optional) ───────────────────────────────────────────────
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# ─── AI (provider pluggabile) ────────────────────────────────────────────────
# AI_PROVIDER: auto | disabled | ollama | gemini | openai
#   auto = ollama se configurato, altrimenti gemini/openai se c'e' la chiave,
#          altrimenti disabled (nessun container, nessun costo, nessun errore).
# Le chiavi Gemini/OpenAI si possono mettere anche dalla dashboard (Settings →
# Integrations): qui in .env vincono sull'override DB.
AI_PROVIDER=auto
AI_MODEL=
# true = arricchimento automatico degli alert. Con provider CLOUD i dati
# anonimizzati escono solo se questo e' true; con provider locale nessun limite.
AI_AUTOMATIC_ENRICH=false
AI_RATE_LIMIT_PER_MIN=10
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── Ollama opzionale (profilo docker 'ollama') ───────────────────────────────
# Attiva con:  AEGIS_WITH_AI=1 aegis.bat start   (oppure docker compose --profile ollama up -d)
# OLLAMA_URL: puo' puntare a un server potente in rete invece che al container
# locale: OLLAMA_URL=http://192.168.1.50:11434/api/generate
OLLAMA_URL=http://aegis-ollama:11434/api/generate
OLLAMA_PORT_EXTERNAL=11435
# Modello locale: quello che il tuo hardware regge (llama3, qwen2.5:14b, ...).
# AEGIS_OLLAMA_MODEL e' il modello che aegis.bat scarica all'avvio AI.
OLLAMA_DEFAULT_MODEL=llama3
AEGIS_OLLAMA_MODEL=llama3
# Modelli selezionabili dalla UI/API (allowlist, niente pull arbitrari).
OLLAMA_ALLOWED_MODELS=

# ─── PUBLIC DOMAIN / TLS (Caddy) ─────────────────────────────────────────────
# Caddy reads these values. The lab default is aegis.local + internal CA.
# For a real deployment use a public FQDN whose DNS A/AAAA points to this host,
# with ports 80/443 reachable for the ACME challenge, and a real account email:
#   AEGIS_DOMAIN=soc.example.com
#   ACME_EMAIL=admin@example.com
# ALLOWED_ORIGINS and PUBLIC_BASE_URL below must use the same host.
AEGIS_DOMAIN=aegis.local
ACME_EMAIL=internal

# ─── FRONTEND / CORS / TLS ───────────────────────────────────────────────────
# Must match AEGIS_DOMAIN. :5173 = Vite dev (E2E Playwright); rimuovere se il
# dev-server non serve.
ALLOWED_ORIGINS=https://aegis.local,http://localhost:3000,http://localhost:5173
VITE_API_URL=/api/v1
AEGIS_BRAIN_URL=https://aegis.local/api/v1

# ─── AGENT DEFAULTS ──────────────────────────────────────────────────────────
# Endpoint usati dall'agente SUL HOST (aegis.bat li imposta da solo).
# AEGIS_GATEWAY_URL e' dove l'agente consegna la telemetria: se non finisce
# con /telemetry/report la telemetria non arriva al brain. La variabile
# storica puntava a "aegis-link", il tier Java rimosso: un agente con quel
# valore resta cieco senza dirlo a nessuno.
AEGIS_BRAIN_URL=http://127.0.0.1:8000/api/v1
AEGIS_GATEWAY_URL=http://127.0.0.1:8000/api/v1/telemetry/report
AEGIS_SCAN_INTERVAL_MS=1000
NODETRACE_DEVICE_NAME=NodeTrace-Agent
# L'id agente NON si fissa qui: lo assegna l'enroll e vive in secret.json
# (fissarlo renderebbe identici piu' endpoint della stessa flotta).

# ─── M1 MODERN DEPLOY (Falcon-style) ───────────────────────────────────────
ALLOW_DEMO=false
RULE_CANARY_IDS=
DEPLOY_TOKEN_TTL_MINUTES=15
ARTIFACT_DIR=/app/artifacts
# Public origin used by OIDC callbacks and deployment links. Keep the same host
# as AEGIS_DOMAIN.
PUBLIC_BASE_URL=https://aegis.local

# ─── DEVICE PKI (M6, fuori dal repo) ─────────────────────────────────────────
PKI_DIR=/app/pki
PKI_CA_TTL_DAYS=3650
PKI_DEVICE_TTL_DAYS=825
# Mutual auth agent: off | optional | required (pilot: required + Caddyfile.mtls)
MTLS_MODE=off
# Number of Brain uvicorn workers. More than one requires a shared Redis
# rate-limit backend; memory storage would duplicate counters per worker.
BRAIN_WORKERS=2
# Reject the legacy X-Client-Cert header; clients must send X-Client-Cert-Hash.
MTLS_REJECT_LEGACY_HEADER=true

# ─── PROFILI (lab vs enterprise, audit) ──────────────────────────────────────
# NOMI: docker-compose legge SOLO i nomi namespaced qui sotto (AEGIS_DEBUG, non
# DEBUG: una variabile generica dell'host puo' sovrascrivere il .env in silenzio).
# Default SICURO = produzione. Con AEGIS_DEBUG=false il brain VALIDA i secret (rifiuta
# quelli corti o con placeholder), non riversa l'SQL di ogni query nei log e
# vieta il CORS wildcard con credenziali.
# Con AEGIS_ALLOW_OPEN_REGISTRATION=false solo un admin crea utenti: il primo si crea
# da shell con `python -m app.admin bootstrap <email> <password>`.
# Per il LAB (registrazione libera, SQL echo, diagnosi verbosa) vanno rimessi
# AEGIS_DEBUG=true e AEGIS_ALLOW_OPEN_REGISTRATION=true: e' una scelta esplicita.
AEGIS_DEBUG=false
AEGIS_ALLOW_OPEN_REGISTRATION=false

# ─── SECRET SOURCES (production) ─────────────────────────────────────────────
# Do NOT put real secrets in a public CI file. The brain resolves, in order:
#   1. NAME_FILE (Docker/Kubernetes secret file)
#   2. AEGIS_SECRETS_DIR (directory of files named after env variables)
#   3. HashiCorp Vault KV v2 (opt-in, fills only missing values)
# Compose del repo: metti i file in ./secrets (montata su /run/secrets).
# Example: mount JWT_SECRET at /run/secrets/aegis/JWT_SECRET and set:
# AEGIS_SECRETS_DIR=/run/secrets/aegis
# Or: JWT_SECRET_FILE=/run/secrets/JWT_SECRET
# Vault keys are ordinary env names (JWT_SECRET, POSTGRES_PASSWORD, ...).
AEGIS_SECRETS_DIR=
AEGIS_VAULT_ENABLED=false
AEGIS_VAULT_ADDR=
AEGIS_VAULT_MOUNT=secret
AEGIS_VAULT_PATH=aegis
AEGIS_VAULT_NAMESPACE=
AEGIS_VAULT_TOKEN_FILE=
AEGIS_VAULT_CACERT=
AEGIS_VAULT_SKIP_VERIFY=false
# Optional: allow Vault to override an already-present variable (default false).
AEGIS_VAULT_OVERRIDE=false

# ─── OIDC / SSO umano (opzionale; admin locale resta il break-glass) ──────────
# Callback da registrare nel provider:
#   https://<PUBLIC_BASE_URL>/api/v1/auth/oidc/callback
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_BUTTON_LABEL=Sign in with SSO
OIDC_GROUPS_CLAIM=groups
# JSON object: {"aegis-admins":"admin","aegis-analysts":"analyst"}
OIDC_GROUP_ROLE_MAP={}
OIDC_DEFAULT_ROLE=viewer
OIDC_AUTO_CREATE_USERS=true
OIDC_LINK_BY_EMAIL=true
OIDC_SYNC_ROLE=true
OIDC_REQUIRE_VERIFIED_EMAIL=true
OIDC_ALLOW_LOCAL_LOGIN=true
# Flag `Secure` sui cookie di sessione. La dashboard e' servita da Caddy in
# HTTPS anche con il nome lab `aegis.local`, quindi il default resta true.
# Va messo a false SOLO per un accesso diretto in HTTP su localhost, perche'
# il browser non invierebbe un cookie Secure su http:// e il login sembrerebbe
# rotto.
AEGIS_COOKIE_SECURE=true

# ── Kraken vertical (docker compose --profile kraken) ──────────────────────
# The Brain only signs a one-minute SSO assertion and verifies signed ingest.
# Generate distinct secrets; never reuse JWT_SECRET or AEGIS_API_KEY.
KRAKEN_SSO_ENABLED=false
KRAKEN_SSO_SECRET=
KRAKEN_SSO_TTL_SECONDS=60
KRAKEN_INGEST_ENABLED=false
KRAKEN_INGEST_KEY=
KRAKEN_INGEST_SECRET=
KRAKEN_SECRET_KEY=
KRAKEN_INTERNAL_API_KEY=
KRAKEN_DB_PASSWORD=
KRAKEN_REDIS_PASSWORD=
SANDBOX_BROKER_TOKEN=
KRAKEN_PORT_EXTERNAL=8001
# Honeypot overlay only. The base profile keeps every sensor internal.
# Use standard ports on a dedicated lab host; do not expose these on a pilot
# host. Set KRAKEN_HONEYPOT_BIND_IP=0.0.0.0 explicitly for LAN exposure.
KRAKEN_HONEYPOT_BIND_IP=127.0.0.1
KRAKEN_SSH_PORT=22
KRAKEN_HTTP_PORT=80
KRAKEN_FTP_PORT=21
KRAKEN_TELNET_PORT=23
KRAKEN_SMB_PORT=445
KRAKEN_RDP_PORT=3389
KRAKEN_SENSOR_PROTOCOLS=ssh,http
KRAKEN_FTP_PASV_MIN=30000
KRAKEN_FTP_PASV_MAX=30009
KRAKEN_FTP_PASV_ADVERTISE_HOST=
# Required for signed sensor configuration; empty disables the config endpoint.
KRAKEN_SENSOR_CONFIG_SIGNING_KEY=
# ENTERPRISE_STRICT=true richiede MTLS_MODE=required e registrazione chiusa,
# altrimenti il brain rifiuta l'avvio (usare con overlay prod+mtls).
ENTERPRISE_STRICT=false
# Azioni playbook "script" (shell sul server): disabilitate di default,
# abilitare solo in enterprise con approvazione documentata.
PLAYBOOK_SCRIPT_ENABLED=false

# ─── BACKUP (M8, passphrase per cifratura at-rest, mai in chiaro in prod) ────
BACKUP_PASSPHRASE=replace-with-a-long-random-value

# ─── OBSERVABILITY (profilo lab "observability", opzionale) ──────────────────
# Richiesta solo quando si avvia il profilo osservabilità
# (./install.sh lab --observability). Grafana su localhost:3001, Prometheus :9090.
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-value

# ─── PIPELINE (rate limit telemetria per agente) ─────────────────────────────
# Eventi/minuto accettati per agente prima del rate limiting (F1).
APP_EVENTS_PER_MIN=10000

# ─── M2 AEGIS TOTAL ────────────────────────────────────────────────────────
TOTAL_MAX_FILE_MB=100
TOTAL_MAX_ZIP_MB=200
TOTAL_MAX_FILES_PER_ZIP=2000
TOTAL_RETENTION_DAYS=7

# ─── YARA SIGNATURE FEEDS (optional, signed, off by default) ───────────────
# Aegis does not download unsigned rules. Enable only with an operator-owned
# bundle endpoint and its Ed25519 public key. Bundle format and signing steps:
# docs/YARA_FEEDS.md. The private key never belongs in this .env or container.
YARA_FEED_ENABLED=false
# Comma-separated HTTPS URLs. HTTP is accepted only for explicit localhost tests.
YARA_FEED_URLS=
# base64(raw 32-byte Ed25519 public key)
YARA_FEED_PUBLIC_KEY_B64=
YARA_FEED_KEY_ID=
YARA_FEED_INTERVAL_S=3600
YARA_FEED_TIMEOUT_S=20
YARA_FEED_MAX_BYTES=8388608
YARA_FEED_ALLOW_HTTP=false

# ─── DATA RETENTION (giorni, decisioni M0) ───────────────────────────────────
RETENTION_TELEMETRY_DAYS=14
RETENTION_ALERTS_DAYS=90
RETENTION_AUDIT_DAYS=365
RETENTION_SYSLOG_DAYS=30

# ─── SIEM v4 (ingestione multi-sorgente + detection) ────────────────────────
# SIEM_ENABLED=false spegne l'intero percorso di ingestione esterna (parser,
# store eventi, regole Sigma, correlazione) lasciando intatta la pipeline agenti.
SIEM_ENABLED=true
SIEM_RETENTION_DAYS=30
# Dedup degli eventi: un relay che reinvia la stessa riga non genera alert duplicati.
SIEM_EVENT_DEDUP_TTL_S=86400
# Bound sull'ingestione: oltre questo numero di eventi il payload viene troncato.
SIEM_MAX_EVENTS_PER_REQUEST=5000
# Limite massimo di risultati restituiti da una singola ricerca.
SIEM_SEARCH_MAX_LIMIT=500

# Listener syslog UDP+TCP. Default OFF: nessuna porta in ascolto finché non lo
# abiliti esplicitamente (rsyslog/firewall puntano qui).
SYSLOG_ENABLED=false
# 127.0.0.1 = solo locale (default sicuro). Metti 0.0.0.0 SOLO se ricevi da
# rsyslog/firewall su altri host, e solo dietro firewall/segmentazione.
SYSLOG_BIND=127.0.0.1
SYSLOG_PORT=5514
SYSLOG_TCP_ENABLED=true

