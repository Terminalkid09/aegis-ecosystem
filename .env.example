# .env.example for Aegis XDR Ecosystem
# Copy to .env and replace every placeholder before use.

# ─── Docker Compose (recommended) ───────────────────────────────────────────
# When using `docker compose up`, service hostnames are container names.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=aegis
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-postgres-password@aegis-postgres:5432/aegis

REDIS_PASSWORD=replace-with-a-long-random-value
REDIS_URL=redis://:replace-with-a-long-random-value@aegis-redis:6379
REDIS_HOST=aegis-redis
REDIS_PORT=6379
REDIS_PORT_EXTERNAL=6379

# ─── Local development (services on localhost) ──────────────────────────────
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/aegis
# REDIS_URL=redis://:your_redis_password@localhost:6379
# REDIS_HOST=localhost

# ─── SERVICE PORTS ───────────────────────────────────────────────────────────
POSTGRES_PORT=5444
BRAIN_PORT_EXTERNAL=8000
LINK_PORT_EXTERNAL=8088
OLLAMA_PORT_EXTERNAL=11435

# ─── SECURITY (REQUIRED: generate with `python -c "import secrets; print(secrets.token_hex(32))"`) ─────
AEGIS_API_KEY=replace-with-random-hex-32-chars-min
AGENT_ENROLL_KEY=replace-with-random-value
JWT_SECRET=replace-with-at-least-32-random-characters
MASTER_KEY_B64=replace-with-openssl-rand-32-base64
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── OSINT API KEYS (optional) ───────────────────────────────────────────────
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# ─── AI (provider pluggabile) ────────────────────────────────────────────────
# AI_PROVIDER: auto | disabled | ollama | gemini | openai
#   auto = ollama se configurato, altrimenti gemini/openai se c'e' la chiave,
#          altrimenti disabled (nessun container, nessun costo, nessun errore).
# Le chiavi Gemini/OpenAI si possono mettere anche dalla dashboard (Settings →
# Integrations): qui in .env vincono sull'override DB.
AI_PROVIDER=auto
AI_MODEL=
# true = arricchimento automatico degli alert. Con provider CLOUD i dati
# anonimizzati escono solo se questo e' true; con provider locale nessun limite.
AI_AUTOMATIC_ENRICH=false
AI_RATE_LIMIT_PER_MIN=10
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── Ollama opzionale (profilo docker 'ollama') ───────────────────────────────
# Attiva con:  AEGIS_WITH_AI=1 aegis.bat start   (oppure docker compose --profile ollama up -d)
# OLLAMA_URL: puo' puntare a un server potente in rete invece che al container
# locale: OLLAMA_URL=http://192.168.1.50:11434/api/generate
OLLAMA_URL=http://aegis-ollama:11434/api/generate
OLLAMA_PORT_EXTERNAL=11435
# Modello locale: quello che il tuo hardware regge (llama3, qwen2.5:14b, ...).
# AEGIS_OLLAMA_MODEL e' il modello che aegis.bat scarica all'avvio AI.
OLLAMA_DEFAULT_MODEL=llama3
AEGIS_OLLAMA_MODEL=llama3
# Modelli selezionabili dalla UI/API (allowlist, niente pull arbitrari).
OLLAMA_ALLOWED_MODELS=

# ─── FRONTEND / CORS / TLS ───────────────────────────────────────────────────
# :5173 = Vite dev (E2E Playwright); rimuovere se il dev-server non serve.
ALLOWED_ORIGINS=https://aegis.local,http://localhost:3000,http://localhost:5173
VITE_API_URL=/api/v1
AEGIS_BRAIN_URL=https://aegis.local/api/v1

# ─── AGENT DEFAULTS ──────────────────────────────────────────────────────────
AEGIS_AGENT_ID=agent-001
AEGIS_SCAN_INTERVAL_MS=1000
NODETRACE_DEVICE_NAME=NodeTrace-Agent

# ─── M1 MODERN DEPLOY (Falcon-style) ───────────────────────────────────────
ALLOW_DEMO=false
RULE_CANARY_IDS=
DEPLOY_TOKEN_TTL_MINUTES=15
ARTIFACT_DIR=/app/artifacts
PUBLIC_BASE_URL=https://aegis.local

# ─── DEVICE PKI (M6, fuori dal repo) ─────────────────────────────────────────
PKI_DIR=/app/pki
PKI_CA_TTL_DAYS=3650
PKI_DEVICE_TTL_DAYS=825
# Mutual auth agent: off | optional | required (pilot: required + Caddyfile.mtls)
MTLS_MODE=off

# ─── PROFILI (lab vs enterprise, audit) ──────────────────────────────────────
# DEBUG=true = lab (registrazione aperta permessa). Produzione: DEBUG=false
# + ALLOW_OPEN_REGISTRATION=false, altrimenti il brain rifiuta l'avvio.
DEBUG=true
ALLOW_OPEN_REGISTRATION=true
# ENTERPRISE_STRICT=true richiede MTLS_MODE=required e registrazione chiusa,
# altrimenti il brain rifiuta l'avvio (usare con overlay prod+mtls).
ENTERPRISE_STRICT=false
# Azioni playbook "script" (shell sul server): disabilitate di default,
# abilitare solo in enterprise con approvazione documentata.
PLAYBOOK_SCRIPT_ENABLED=false

# ─── BACKUP (M8, passphrase per cifratura at-rest, mai in chiaro in prod) ────
BACKUP_PASSPHRASE=replace-with-a-long-random-value

# ─── OBSERVABILITY (profilo lab "observability", opzionale) ──────────────────
# Richiesta solo quando si avvia il profilo osservabilità
# (./install.sh lab --observability). Grafana su localhost:3001, Prometheus :9090.
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-value

# ─── PIPELINE (rate limit telemetria per agente) ─────────────────────────────
# Eventi/minuto accettati per agente prima del rate limiting (F1).
APP_EVENTS_PER_MIN=10000

# ─── M2 AEGIS TOTAL ────────────────────────────────────────────────────────
TOTAL_MAX_FILE_MB=100
TOTAL_MAX_ZIP_MB=200
TOTAL_MAX_FILES_PER_ZIP=2000
TOTAL_RETENTION_DAYS=7

# ─── DATA RETENTION (giorni, decisioni M0) ───────────────────────────────────
RETENTION_TELEMETRY_DAYS=14
RETENTION_ALERTS_DAYS=90
RETENTION_AUDIT_DAYS=365
RETENTION_SYSLOG_DAYS=30

# ─── SIEM v4 (ingestione multi-sorgente + detection) ────────────────────────
# SIEM_ENABLED=false spegne l'intero percorso di ingestione esterna (parser,
# store eventi, regole Sigma, correlazione) lasciando intatta la pipeline agenti.
SIEM_ENABLED=true
SIEM_RETENTION_DAYS=30
# Dedup degli eventi: un relay che reinvia la stessa riga non genera alert duplicati.
SIEM_EVENT_DEDUP_TTL_S=86400
# Bound sull'ingestione: oltre questo numero di eventi il payload viene troncato.
SIEM_MAX_EVENTS_PER_REQUEST=5000
# Limite massimo di risultati restituiti da una singola ricerca.
SIEM_SEARCH_MAX_LIMIT=500

# Listener syslog UDP+TCP. Default OFF: nessuna porta in ascolto finché non lo
# abiliti esplicitamente (rsyslog/firewall puntano qui).
SYSLOG_ENABLED=false
# 127.0.0.1 = solo locale (default sicuro). Metti 0.0.0.0 SOLO se ricevi da
# rsyslog/firewall su altri host, e solo dietro firewall/segmentazione.
SYSLOG_BIND=127.0.0.1
SYSLOG_PORT=5514
SYSLOG_TCP_ENABLED=true

