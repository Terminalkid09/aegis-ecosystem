# Copy to /etc/aegis-agent/aegis-agent.env and restrict to root:root 0600.
# The service reads this file only; do not put secrets in the package.
AEGIS_AGENT_PROFILE=unified
AEGIS_AGENT_MODE=full
AEGIS_BRAIN_URL=https://aegis.example.com
AEGIS_IDENTITY_DIR=/var/lib/aegis-agent
AEGIS_ENROLL_TOKEN_FILE=/etc/aegis-agent/enroll.token
# Enable only after reviewing the kernel/privilege requirements:
# NODETRACE_EBPF=true
# NODETRACE_EBPF_COLLECTOR=/usr/local/lib/aegis-agent/aegis-collector
# NODETRACE_EBPF_OBJ=/usr/local/lib/aegis-agent/aegis_exec.bpf.o
