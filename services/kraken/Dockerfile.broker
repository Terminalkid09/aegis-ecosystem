FROM python:3.11-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY requirements-broker.txt .
RUN pip install --no-cache-dir -r requirements-broker.txt

COPY app ./app
COPY broker ./broker

RUN mkdir -p /app/data/malware && \
    adduser --disabled-password --gecos "" --home /app broker && \
    chown -R broker:broker /app/data

USER broker

EXPOSE 8100

CMD ["uvicorn", "broker.main:app", "--host", "0.0.0.0", "--port", "8100"]
