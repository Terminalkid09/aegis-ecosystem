# ─────────────────────────────────────────────
# Kraken — Environment Configuration
# Copy to .env and fill in every required value.
# ─────────────────────────────────────────────

# App
DEBUG=false
ALLOW_REGISTRATION=false
PROFILE=prod
# Empty when standalone; /kraken when mounted behind Aegis Caddy.
PUBLIC_BASE_PATH=

# Required. Generate each with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
INTERNAL_API_KEY=
SANDBOX_BROKER_TOKEN=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
GRAFANA_PASSWORD=

# Database (used by docker-compose automatically)
DATABASE_URL=postgresql+asyncpg://kraken:CHANGE_ME@kraken_db:5432/krakendb

# Redis
REDIS_URL=redis://:CHANGE_ME@kraken_redis:6379/0

# GeoIP — download GeoLite2-City.mmdb from https://dev.maxmind.com
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb

# Telegram Bot Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:80

# Sensor ports (exposed by docker-compose)
SSH_SENSOR_PORT=2222
HTTP_SENSOR_PORT=8080
FTP_SENSOR_PORT=2121
TELNET_SENSOR_PORT=2323
SMB_SENSOR_PORT=445
RDP_SENSOR_PORT=3389

# Signed sensor configuration. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SENSOR_CONFIG_SIGNING_KEY=

# Async static file analysis (no detonation, no network).
FILE_ANALYSIS_ENABLED=true
FILE_ANALYSIS_MAX_BYTES=67108864
FILE_ANALYSIS_TIMEOUT_S=30
FILE_ANALYSIS_STORAGE_DIR=/app/data/samples

# Sandbox
SANDBOX_IMAGE=kraken_sandbox
SANDBOX_MAX_LIFETIME=300
SANDBOX_MAX_CONCURRENT=20
MALWARE_MAX_FILE_BYTES=67108864
MALWARE_MAX_SESSION_BYTES=268435456
MALWARE_RETENTION_DAYS=30
MALWARE_MAX_TOTAL_BYTES=5368709120

# Rate limiting
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_INGEST=200/minute
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_EXPORT=30/minute

# Data directories
DATA_DIR=/app/data
MALWARE_DIR=/app/data/malware
LOGS_DIR=/app/data/logs

# Sandbox broker (the only process allowed to mount docker.sock)
SANDBOX_BROKER_URL=http://kraken_sandbox_broker:8100
SANDBOX_API_URL=http://kraken_app:8000/api/v1/containers

# Delegated login from Aegis Brain (separate key, audience kraken)
KRAKEN_SSO_ENABLED=false
KRAKEN_SSO_SECRET=
KRAKEN_SSO_ISSUER=aegis-brain
KRAKEN_SSO_AUDIENCE=kraken

# Aegis control plane (disabled by default; the outbox only fills when on)
AEGIS_INGEST_ENABLED=false
AEGIS_INGEST_URL=http://aegis-brain:8000
AEGIS_INGEST_KEY=
AEGIS_INGEST_SECRET=
AEGIS_INGEST_TIMEOUT_S=5
AEGIS_OUTBOX_POLL_INTERVAL_S=2
AEGIS_OUTBOX_BATCH_SIZE=500
AEGIS_OUTBOX_MAX_ATTEMPTS=8
AEGIS_OUTBOX_BACKOFF_BASE_S=2
AEGIS_OUTBOX_BACKOFF_MAX_S=300
AEGIS_OUTBOX_STALE_AFTER_S=300

# Security
BCRYPT_ROUNDS=12
MAX_BODY_SIZE=65536
